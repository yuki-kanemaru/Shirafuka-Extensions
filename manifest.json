{
  "manifest_version": 3,
  "name": "Shirafuka Extensions",
  "version": "1.1.0",
  "description": "Googleカレンダーのプリセット切替、BookWalker作品一覧の一括チェック、チャットのCtrl+Enter送信をまとめた自分用の拡張機能です。",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://bookwalker.jp/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.google.com/*",
    "https://mail.google.com/chat/*"
  ],
  "action": {
    "default_title": "Shirafuka Extensions",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": [
        "src/content/shared.js",
        "src/content/calendar-dom-adapter.js",
        "src/content/calendar.js"
      ],
      "css": ["src/content/calendar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bookwalker.jp/series/*/list/*"],
      "js": ["src/content/shared.js", "src/content/bookwalker.js"],
      "css": ["src/content/bookwalker.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.google.com/*",
        "https://mail.google.com/chat/*"
      ],
      "js": [
        "src/content/shared.js",
        "src/content/ctrl-enter-core.js",
        "src/content/ctrl-enter.js"
      ],
      "run_at": "document_start"
    }
  ]
}
